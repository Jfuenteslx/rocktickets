# ============================================================
# Rocktickets (monorepo: backend, admin, door, frontend)
# ============================================================

# --- Secretos: NUNCA al repositorio ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencias ---
node_modules/

# --- Compilados y caché generada ---
dist/
dist-ssr/
build/
.adminjs/
*.tsbuildinfo
coverage/
.cache/

# --- Expo / app de puerta ---
.expo/
.expo-shared/
*.apk
*.aab
*.ipa

# --- Archivos generados al usar el sistema ---
backend/uploads/

# --- Volcados y respaldos de base de datos (pueden tener datos reales) ---
*.dump
*.backup
*.bak

# --- Respaldos comprimidos sueltos ---
*.zip

# --- Residuo vacío en la raíz (no pertenece a ninguna app) ---
/package-lock.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor y sistema operativo ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
