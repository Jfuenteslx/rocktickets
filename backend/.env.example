# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL (formato: postgresql://usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/rocktickets

# Secreto para firmar las sesiones (cadena larga y aleatoria, distinta en cada entorno)
JWT_SECRET=

# Conexión a Redis (colas y reservas con expiración)
REDIS_URL=redis://localhost:6379

# Pasarela de pago. Por ahora solo existe el simulador de PagosYa.
PAYMENTS_PROVIDER=pagosya-sim

# Secreto compartido con PagosYa para firmar los avisos de pago (webhooks).
# En producción es OBLIGATORIO (cadena larga y aleatoria); en desarrollo hay un valor por defecto.
PAGOSYA_WEBHOOK_SECRET=

# Correo (confirmación de pago y "recuperar mis tickets") con Resend.
# Sin RESEND_API_KEY los correos solo se imprimen en la consola del backend.
RESEND_API_KEY=
# Remitente: con un dominio verificado en Resend, p. ej. "Rocktickets <entradas@tudominio.com>".
# Mientras no haya dominio, Resend solo deja enviar con onboarding@resend.dev a TU propio correo.
MAIL_FROM=Rocktickets <onboarding@resend.dev>
# URL pública del frontend: se usa para armar los enlaces de los correos
PUBLIC_SITE_URL=http://localhost:5173
