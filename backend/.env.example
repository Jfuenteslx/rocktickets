# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL (formato: postgresql://usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/rocktickets

# Secreto para firmar las sesiones (cadena larga y aleatoria, distinta en cada entorno)
JWT_SECRET=

# Conexión a Redis (colas y reservas con expiración)
REDIS_URL=redis://localhost:6379

# Pagos: verificación manual. El comprador paga con el QR de TU cuenta (imagen en assets/pago-qr.png),
# avisa "ya pagué" y tú apruebas el pago desde el panel (Pagos). Aprobar envía las entradas por correo.
# Ruta de la imagen del QR de cobro (por defecto assets/pago-qr.png, relativa a la carpeta del backend)
# MANUAL_PAYMENT_QR_PATH=assets/pago-qr.png
# Textos que se muestran junto al QR (opcionales)
# PAYMENT_BANK_NAME=Banco Económico
# PAYMENT_ACCOUNT_HOLDER=Nombre del titular
# PAYMENT_INSTRUCTIONS=Escribe en el detalle del pago el código de tu orden.
# Horas que se mantienen reservadas las entradas mientras verificas un pago avisado (por defecto 48)
# MANUAL_REVIEW_HOLD_HOURS=48
# Correo que recibe un aviso cada vez que entra un pago por verificar (opcional, recomendado)
# REVIEW_NOTIFY_EMAIL=
# URL pública del panel admin: el aviso incluye un botón a la bandeja de pagos (opcional)
# ADMIN_URL=https://admin.tudominio.com

# Correo (confirmación de pago y "recuperar mis tickets") con Resend.
# Sin RESEND_API_KEY los correos solo se imprimen en la consola del backend.
RESEND_API_KEY=
# Remitente: con un dominio verificado en Resend, p. ej. "Rocktickets <entradas@tudominio.com>".
# Mientras no haya dominio, Resend solo deja enviar con onboarding@resend.dev a TU propio correo.
MAIL_FROM=Rocktickets <onboarding@resend.dev>
# URL pública del frontend: se usa para armar los enlaces de los correos
PUBLIC_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# PRODUCCIÓN (NODE_ENV=production): el servidor NO arranca si falta algo de esto.
# ---------------------------------------------------------------------------
NODE_ENV=production

# Dominios que pueden llamar a la API desde un navegador (sitio público y panel), separados por comas.
# Sin barra final. No se admite "*".
CORS_ORIGINS=https://tudominio.com,https://admin.tudominio.com

# Detrás de nginx/Caddy: número de proxies de confianza (normalmente 1)
TRUST_PROXY=1

# JWT_SECRET: mínimo 32 caracteres aleatorios (ej. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
# En producción también es obligatorio que exista el archivo del QR de cobro (ver arriba).

# AdminJS (panel viejo, dentro del mismo proceso): apagado por defecto en producción.
# Para encenderlo hace falta un secreto de sesión propio, distinto de JWT_SECRET (32+ caracteres).
# ENABLE_ADMINJS=true
# ADMIN_SESSION_SECRET=
