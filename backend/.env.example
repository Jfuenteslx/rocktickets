# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA se sube al repositorio.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL (formato: postgresql://usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/rocktickets

# Secreto para firmar las sesiones (cadena larga y aleatoria, distinta en cada entorno)
JWT_SECRET=

# Conexión a Redis (colas y reservas con expiración)
REDIS_URL=redis://localhost:6379
